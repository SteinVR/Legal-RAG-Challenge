      "kind": "paragraph",
      "page_number": 2,
      "text": "The grounds of appeal were the",
      "bbox": [
        56.667,
        374.253,
        238.667,
        391.253
      ],
      "heading_level": null,
      "linked_content_id": null
    },
    {
