      "kind": "paragraph",
      "page_number": 2,
      "text": "same as the grounds advanced in the Initial Application for Issued by:",
      "bbox": [
        241.333,
        377.92,
        272.667,
        388.587
      ],
      "heading_level": null,
      "linked_content_id": null
    },
    {
