      "kind": "paragraph",
      "page_number": 2,
      "text": "permission to appeal;",
      "bbox": [
        46.667,
        353.92,
        165.333,
        371.587
      ],
      "heading_level": null,
      "linked_content_id": null
    },
    {
      "node_id": "0471e83c1ea18086cfb6b3ff51da6f22b0efee337f10315b2593f782297ccb84-n66",
      "kind": "paragraph",
      "page_number": 2,
      "text": "The skeleton served in opposition to the Renewed Application drew heavily upon the skeleton",
      "bbox": [
