      "node_id": "f4c4d051d514270964adcf58e124569e396602340b7d9172671759de10a95897-n125",
      "kind": "paragraph",
      "page_number": 2,
      "text": "\"Consideration of Permission without a Hearing 53.94",
      "bbox": [
        47.333,
        165.92,
        347.333,
        182.253
      ],
      "heading_level": null,
      "linked_content_id": null
    },
    {
