      "node_id": "3a574fc4f0baa5ec7ff0dcc822d7c55e4f9c493c24addc217c8df3d848c16fa5-p3-b1",
      "kind": "paragraph",
      "page_number": 3,
      "text": "10. This is an application by the Defendant, to adjourn the Hearing scheduled at 10:30am on Monday,",
      "bbox": null,
      "heading_level": null,
      "linked_content_id": null
    },
    {
      "node_id": "3a574fc4f0baa5ec7ff0dcc822d7c55e4f9c493c24addc217c8df3d848c16fa5-p3-b2",
      "kind": "paragraph",
      "page_number": 3,
      "text": "15 December 2025.",
      "bbox": null,
      "heading_level": null,
      "linked_content_id": null
    },
    {
