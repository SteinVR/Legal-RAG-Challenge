    {
      "node_id": "3a574fc4f0baa5ec7ff0dcc822d7c55e4f9c493c24addc217c8df3d848c16fa5-p2-b11",
      "kind": "paragraph",
      "page_number": 2,
      "text": "The Parties",
      "bbox": null,
      "heading_level": null,
