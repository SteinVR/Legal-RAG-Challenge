      "kind": "paragraph",
      "page_number": 1,
      "text": "UPON reviewing the Order of Small Claims Tribunal Judge Maitha AI Alshehhi dated 30 October 2024",
      "bbox": null,
      "heading_level": null,
      "linked_content_id": null
    },
    {
      "node_id": "f4c4d051d514270964adcf58e124569e396602340b7d9172671759de10a95897-p1-b14",
      "kind": "paragraph",
