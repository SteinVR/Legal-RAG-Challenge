    },
    {
      "node_id": "1b446e196b4d1752241c8ff689a31ea705e98ad0c16b9d343c303664f72b64a1-p1-b22",
      "kind": "paragraph",
      "page_number": 1,
      "text": "IT IS HEREBY ORDERED THAT:",
      "bbox": null,
