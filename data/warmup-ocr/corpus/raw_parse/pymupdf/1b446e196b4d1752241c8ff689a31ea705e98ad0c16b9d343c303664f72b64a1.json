    },
    {
      "node_id": "1b446e196b4d1752241c8ff689a31ea705e98ad0c16b9d343c303664f72b64a1-p2-b1",
      "kind": "paragraph",
      "page_number": 2,
      "text": "1. The Permission to Appeal Application is refused.",
      "bbox": null,
